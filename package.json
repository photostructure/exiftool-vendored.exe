{
  "name": "exiftool-vendored.exe",
  "version": "13.59.2",
  "description": "Vendored win32 ExifTool for Node.js",
  "main": "./index.js",
  "homepage": "https://github.com/photostructure/exiftool-vendored.exe#readme",
  "bugs": {
    "url": "https://github.com/photostructure/exiftool-vendored/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:photostructure/exiftool-vendored.exe.git"
  },
  "os": [
    "win32"
  ],
  "files": [
    "bin",
    "index.js",
    "patches",
    "vendor-manifest.json"
  ],
  "keywords": [
    "ExifTool",
    "EXIF"
  ],
  "author": "Matthew McEachen <matthew-exiftoolvendored@mceachen.org>",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "prettier": "prettier --write .",
    "lint": "prettier --check .",
    "test": "mocha",
    "check:npm-version": "node scripts/check-npm-version.js",
    "preupdate": "npm run check:npm-version",
    "update": "run-s update:*",
    "update:deps": "npm run check:npm-version && npm-check-updates --upgrade --install always",
    "update:exiftool": "node update-exiftool.js",
    "check-version": "node check-version.js",
    "install:pinact": "go install github.com/suzuki-shunsuke/pinact/v4/cmd/pinact@v4.1.0",
    "update:actions": "go run github.com/suzuki-shunsuke/pinact/v4/cmd/pinact@v4.1.0 run -u",
    "preflight": "npm run check:npm-version && run-s update prettier check-version test"
  },
  "devDependencies": {
    "cross-zip": "^4.0.1",
    "mocha": "12.0.0",
    "npm-check-updates": "23.1.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "xml2js": "^0.6.2"
  }
}
